# Local compose settings. `make env` copies this to .env and fills in the secrets.
# Keep TOKEN_PEPPER stable: changing it invalidates every token minted so far.
TOKEN_PEPPER=
POSTGRES_PASSWORD=
MEMSVC_APP_PASSWORD=
MEMSVC_SYSTEM_PASSWORD=

# Interface the API and Postgres bind to on the host. 127.0.0.1 keeps them local; set the
# machine's LAN or Tailscale address to let other machines reach the API.
BIND_ADDR=127.0.0.1
MEMVAULT_PORT=8000
PG_PORT=55432

# ParadeDB bundles pgvector and pg_search (BM25). pgvector/pgvector:pg17 also works and uses the
# tsvector fallback for the keyword leg of recall.
POSTGRES_IMAGE=paradedb/paradedb:0.26.3-pg17
TEI_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-1.8

# 1 replaces TEI with the deterministic in-process embedder (no model download, poor recall).
# `make up-lite` sets it for you.
FAKE_TEI=0

# How often the scheduler runs a consolidation planning pass, in seconds.
PLANNER_INTERVAL_S=86400
LOG_LEVEL=info
